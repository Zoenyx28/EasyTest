# 后端基础设施连接配置（数据库 / Redis / Celery）

# MySQL 数据库连接
DATABASE_URL=mysql+aiomysql://user:password@host:3306/database?charset=utf8mb4

# Redis 连接（用作 Celery 消息代理和结果后端）
REDIS_URL=redis://:password@host:6379/0

# Celery 配置（默认复用 Redis）
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# 项目数据存储路径（Linux 默认 /data/local/project，Windows 默认 backend/data/projects）
# PROJECTS_DATA_DIR=/data/projects

# CORS 允许的前端来源（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://your-frontend-domain.com